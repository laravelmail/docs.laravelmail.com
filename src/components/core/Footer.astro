---
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`border-t border-border mt-12 bg-background ${className}`}>
    <div class="mx-auto flex max-w-screen-xl flex-col items-center p-4 text-center md:p-8 lg:p-10">
        <div class="mb-8">
            <a
                data-testid="flowbite-footer-brand"
                href="https://laravelmail.com"
                class="flex items-center justify-center"
            >
                <img
                    alt="Laravel Mail logo"
                    src="https://app.laravelmail.com/logo.svg"
                    class="mr-3 h-8"
                />
                <span
                    data-testid="flowbite-footer-brand-span"
                    class="text-foreground self-center text-2xl font-semibold whitespace-nowrap"
                    >Laravel Mail</span
                >
            </a>
        </div>
        <p class="text-muted-foreground mb-6 text-sm sm:mb-0">
            Part of the <a href="https://laravelcompany.com" class="text-foreground hover:underline"
                >Laravel Company</a
            > ecosystem, delivering integrated messaging, e-commerce, and SEO solutions.
        </p>

        <span class="text-muted-foreground text-sm sm:text-center"
            >© 2026 <a href="https://laravelcompany.com" class="hover:underline">Laravel Software</a
            >. All Rights Reserved.</span
        >
    </div>
</footer>
