---

<div
    id="purchase-toast"
    class="bg-popover border-border fixed bottom-6 left-6 z-[60] flex max-w-sm translate-y-24 items-center gap-4 rounded-xl border p-4 opacity-0 shadow-2xl transition-all duration-700"
>
    <div
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-green-500/10 text-green-600"
    >
        <span class="text-2xl">🛒</span>
    </div>
    <div class="space-y-1">
        <p class="text-foreground text-sm font-bold" id="toast-name">Someone from London</p>
        <p class="text-muted-foreground text-[10px] font-bold tracking-tight uppercase">
            just individual-purchased Laravel Mail
        </p>
        <p class="flex items-center gap-1 text-[10px] leading-none font-bold text-green-600">
            <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"></span> Verified Purchase
        </p>
    </div>
</div>

<script>
    const toast = document.getElementById("purchase-toast");
    const toastName = document.getElementById("toast-name");

    const locations = [
        "Someone from London",
        "Developer from Berlin",
        "Marketer from New York",
        "Founder from Paris",
        "SaaS Owner from Tokyo",
        "Agency from Sydney",
    ];

    if (toast) {
        setTimeout(() => {
            const showToast = () => {
                const randomLocation = locations[Math.floor(Math.random() * locations.length)];
                if (toastName) toastName.textContent = randomLocation;

                toast.classList.remove("translate-y-24", "opacity-0");

                setTimeout(() => {
                    toast.classList.add("translate-y-24", "opacity-0");
                    setTimeout(showToast, 15000 + Math.random() * 10000);
                }, 5000);
            };

            showToast();
        }, 3000);
    }
</script>
