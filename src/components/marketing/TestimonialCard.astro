---
interface Props {
    name: string;
    role: string;
    quote: string;
    imageAlt?: string;
}

const { name, role, quote } = Astro.props;
---

<div
    class="bg-popover border-border group relative flex flex-col gap-6 overflow-hidden rounded-2xl border p-8 shadow-sm transition-shadow hover:shadow-md"
>
    <div class="absolute top-0 right-0 p-4 opacity-5 transition-opacity group-hover:opacity-10">
        <svg class="h-16 w-16" fill="currentColor" viewBox="0 0 24 24"
            ><path
                d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V12C14.017 12.5523 13.5681 13 13.017 13H11.017C10.4647 13 10.017 12.5523 10.017 12V9C10.017 7.34315 11.3601 6 13.017 6H19.017C20.6739 6 22.017 7.34315 22.017 9V15C22.017 16.6569 20.6739 18 19.017 18H16.017C15.4647 18 15.017 18.4477 15.017 19V21H14.017ZM4.017 21L4.017 18C4.017 16.8954 4.91243 16 6.017 16H9.017C9.56927 16 10.017 15.5523 10.017 15V9C10.017 8.44772 9.56927 8 9.017 8H5.017C4.46472 8 4.017 8.44772 4.017 9V12C4.017 12.5523 3.56813 13 3.017 13H1.017C0.464722 13 0.017 12.5523 0.017 12V9C0.017 7.34315 1.36015 6 3.017 6H9.017C10.6739 6 12.017 7.34315 12.017 9V15C12.017 16.6569 10.6739 18 9.017 18H6.017C5.46472 18 5.017 18.4477 5.017 19V21H4.017Z"
            ></path></svg
        >
    </div>

    <p class="text-foreground relative z-10 text-lg leading-relaxed italic">
        "{quote}"
    </p>

    <div class="mt-auto flex items-center gap-4">
        <div
            class="bg-primary/10 text-primary flex h-12 w-12 items-center justify-center rounded-full font-bold"
        >
            {name.charAt(0)}
        </div>
        <div>
            <h4 class="text-foreground font-bold">{name}</h4>
            <p class="text-muted-foreground text-xs">{role}</p>
        </div>
    </div>
</div>
