---
interface Props {
    number: string;
    title: string;
    description: string;
    icon?: string;
}

const { number, title, description } = Astro.props;
---

<div class="group relative flex flex-col items-center space-y-4 text-center">
    <div
        class="bg-muted border-border text-foreground group-hover:bg-primary group-hover:text-primary-foreground flex h-16 w-16 items-center justify-center rounded-2xl border text-2xl font-black shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-lg"
    >
        {number}
    </div>
    <div class="space-y-2">
        <h3 class="text-foreground text-xl leading-snug font-bold">{title}</h3>
        <p class="text-muted-foreground max-w-[240px] text-sm leading-relaxed">
            {description}
        </p>
    </div>
</div>
